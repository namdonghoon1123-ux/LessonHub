# Supabase — 값은 대시보드 > Project Settings > API / Database 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# 서버 전용 (절대 클라이언트 노출 금지) — RLS 우회용 관리자 작업에 사용
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# 마이그레이션/시드 스크립트 직접 접속용 (pooler 또는 direct)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
